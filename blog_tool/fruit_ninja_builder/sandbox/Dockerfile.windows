# Windows Fruit Ninja desktop: 32-bit Wine, Xvfb, software Vulkan, recording, DXVK build tools,
# and the MCP runtime. Builder and solve desktops both start from this image.
# The repository is mounted only for the evaluator, under a directory non-root users cannot enter.
ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS toolchain
COPY toolchain/package.json toolchain/package-lock.json /opt/toolchain/
RUN cd /opt/toolchain && npm ci --omit=dev --no-audit --no-fund --ignore-scripts

FROM ${NODE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && apt-get update \
  && apt-get install -y wine wine32:i386 wine64 \
  && apt-get install -y --no-install-recommends \
       libvulkan1 libvulkan1:i386 mesa-vulkan-drivers mesa-vulkan-drivers:i386 \
       xvfb xdotool x11-utils ffmpeg p7zip-full \
       meson ninja-build gcc-mingw-w64-i686 g++-mingw-w64-i686 \
       git curl ca-certificates tini procps \
       python3 python3-pil python3-numpy python3-matplotlib libx11-6 libxtst6 \
  && update-alternatives --set i686-w64-mingw32-gcc /usr/bin/i686-w64-mingw32-gcc-posix \
  && update-alternatives --set i686-w64-mingw32-g++ /usr/bin/i686-w64-mingw32-g++-posix \
  && rm -rf /var/lib/apt/lists/* \
  && git config --system --add safe.directory '*'
# The game exits when XACT finds no audio device; containers have no sound card. Discard audio.
RUN printf 'pcm.!default {\n  type null\n}\n' > /etc/asound.conf
# MCP runtime: @modelcontextprotocol/sdk and zod resolve from any directory.
COPY --from=toolchain /opt/toolchain /opt/toolchain
COPY windows/ /opt/fn/
RUN ln -s /opt/toolchain/node_modules /node_modules \
  && chmod 0755 /opt/fn/fn-app /opt/fn/fn-appd /opt/fn/fn-memd /opt/fn/desktop-setup /opt/fn/run-mcp /opt/fn/xinput /opt/fn/scan /opt/fn/files \
  && ln -s /opt/fn/fn-app /usr/local/bin/fn-app \
  && useradd -m -u 10001 -s /bin/bash player \
  && useradd -m -u 10002 -s /bin/bash agent \
  && mkdir -m 0700 /opt/fn-eval /opt/frozen-mcp /opt/fn-private
ENV HOME=/tmp XDG_RUNTIME_DIR=/tmp MPLCONFIGDIR=/tmp/mpl
ENTRYPOINT ["tini", "--"]
