#!/usr/bin/env python3
"""File helpers for the Builder: `peek PATH LIMIT` (head and tail) and `read PATH OFFSET LENGTH`."""
import base64
import io
import json
import os
import sys


def peek(path, limit):
    size = os.path.getsize(path)
    with open(path, 'rb') as stream:
        if size <= limit:
            text = stream.read().decode('utf-8', 'replace')
        else:
            half = limit // 2
            head = stream.read(half).decode('utf-8', 'replace')
            stream.seek(size - half)
            tail = stream.read().decode('utf-8', 'replace')
            text = head + '\n[... %d bytes omitted; full output in %s ...]\n' % (size - 2 * half, path) + tail
    return {'bytes': size, 'text': text}


def read(path, offset, length):
    try:
        from PIL import Image
        with Image.open(path) as image:
            stream = io.BytesIO()
            image.save(stream, format='PNG')
            return {'path': path, 'image': base64.b64encode(stream.getvalue()).decode(), 'mimeType': 'image/png'}
    except Exception:
        pass
    with open(path, encoding='utf-8', errors='replace') as stream:
        stream.seek(0)
        skipped = 0
        while skipped < offset:
            part = stream.read(min(offset - skipped, 1 << 16))
            if not part:
                break
            skipped += len(part)
        text = stream.read(length)
        return {'path': path, 'offset': offset, 'text': text, 'next_offset': offset + len(text), 'eof': not stream.read(1)}


if __name__ == '__main__':
    command, path, *rest = sys.argv[1:]
    try:
        result = peek(path, int(rest[0])) if command == 'peek' else read(path, int(rest[0]), int(rest[1]))
    except OSError as exc:
        result = {'error': str(exc)}
    print(json.dumps(result))
