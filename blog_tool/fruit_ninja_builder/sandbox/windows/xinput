#!/usr/bin/env python3
"""Builder GUI tools: screenshot and X11 input through xdotool. Prints one JSON object."""
import base64
import io
import json
import subprocess
import sys
from PIL import ImageGrab

DISPLAY = json.load(open('/opt/fn/app.json'))['display']


def xdo(*args):
    subprocess.run(['xdotool', *map(str, args)], check=True, env={'DISPLAY': DISPLAY, 'PATH': '/usr/bin:/bin'})


op, *args = sys.argv[1:]
if op == 'screenshot':
    stream = io.BytesIO()
    ImageGrab.grab(xdisplay=DISPLAY).save(stream, 'PNG')
    print(json.dumps({'image': base64.b64encode(stream.getvalue()).decode(), 'mimeType': 'image/png'}))
    sys.exit(0)
if op in ('click', 'right_click', 'double_click'):
    x, y = map(int, args)
    xdo('mousemove', x, y)
    xdo('click', '--repeat', 2 if op == 'double_click' else 1, 3 if op == 'right_click' else 1)
elif op == 'drag':
    x1, y1, x2, y2 = map(int, args)
    xdo('mousemove', x1, y1)
    xdo('mousedown', 1)
    for step in range(1, 21):
        xdo('mousemove', x1 + (x2 - x1) * step // 20, y1 + (y2 - y1) * step // 20)
    xdo('mouseup', 1)
elif op == 'type':
    xdo('type', '--delay', 30, args[0])
elif op == 'key':
    xdo('key', '+'.join(args))
elif op == 'scroll':
    direction, count = args[0], int(args[1])
    if count > 0:
        xdo('click', '--repeat', count, {'up': 4, 'down': 5, 'left': 6, 'right': 7}[direction])
else:
    print(json.dumps({'error': 'unknown operation ' + op}))
    sys.exit(2)
print(json.dumps({'done': op}))
