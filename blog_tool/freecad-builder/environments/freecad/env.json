{
  "id": "freecad_env@0.1",
  "description": "FreeCAD 0.20.2 on a Debian 12 GNOME desktop. Builder environment only; no task files.",
  "observation": [
    {
      "type": "rgb_screen",
      "resolution": [
        1280,
        800
      ]
    }
  ],
  "vnc": {
    "password": "password"
  },
  "resources": {
    "cpu": 4,
    "mem_gb": 8
  },
  "mounts": [
    {
      "source": "scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "/workspace/scripts/install_freecad.sh"
  },
  "user_accounts": [
    {
      "name": "ga",
      "password": "password123",
      "permissions": {
        "env_vars": {
          "DISPLAY": ":1"
        }
      }
    }
  ]
}
